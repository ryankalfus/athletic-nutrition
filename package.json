{
  "name": "nourally",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/start.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src server tests vite.config.js eslint.config.js",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write src server tests vite.config.js",
    "index:usda": "python3 scripts/index-usda.py data/usda/FoodData_Central_csv_2026-04-30.zip data/usda/catalog.sqlite",
    "test:browser": "node scripts/run-browser-checks.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@vitejs/plugin-react": "6.0.4",
    "barcode-detector": "3.2.1",
    "lucide-react": "^1.48.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
